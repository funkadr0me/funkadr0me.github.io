---
// Shared layout for a project case study or a writing piece.
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  kicker?: string;          // small line above the title, e.g. client or publication
  description?: string;
  backHref: string;
  backLabel: string;
  externalLink?: string;
  externalLabel?: string;
}

const { title, kicker, description, backHref, backLabel, externalLink, externalLabel } = Astro.props;
---

<BaseLayout title={`${title} — Purna Anantha`} description={description}>
  <article class="container article">
    <header class="article-head">
      <a class="back u-draw body-sm" href={backHref}>← {backLabel}</a>
      {kicker && <p class="body-sm muted" data-intro style="--intro-delay: 0s">{kicker}</p>}
      <h1 class="headline-lg" data-intro style="--intro-delay: 0.1s">{title}</h1>
      {description && <p class="body-lg lede" data-intro style="--intro-delay: 0.25s">{description}</p>}
      <slot name="meta" />
    </header>
    <slot name="media" />
    <div class="prose" data-intro style="--intro-delay: 0.4s">
      <slot />
    </div>
    {externalLink && (
      <p class="external">
        <a class="u-draw" href={externalLink}>{externalLabel ?? 'View the original'} ↗</a>
      </p>
    )}
  </article>
</BaseLayout>

<style>
  .article {
    padding-block: var(--space-lg) var(--space-xl);
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }
  .article-head {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    max-width: 960px;
  }
  .back { align-self: flex-start; color: var(--text); margin-bottom: var(--space-sm); }
  .lede { max-width: 640px; }
  .external { max-width: 680px; }

  /* Long-form text from Markdown */
  .prose {
    max-width: 680px;
    font-size: 18px;
    line-height: 30px;
  }
  .prose > :global(*) { margin-block: 0; }
  .prose > :global(* + *) { margin-top: 1.1em; }
  .prose > :global(h2) {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 45px;
    line-height: 54px;
    letter-spacing: -0.36px;
    margin-top: 1.6em;
  }
  .prose > :global(h3) {
    font-weight: 400;
    font-size: 27px;
    line-height: 32px;
    margin-top: 1.4em;
  }
  .prose > :global(:first-child) { margin-top: 0; }
  .prose :global(ul), .prose :global(ol) { padding-left: 1.2em; }
  .prose :global(li + li) { margin-top: 0.4em; }
  .prose :global(blockquote) {
    margin: 1.6em 0;
    padding: 0;
    font-family: var(--font-display);
    font-size: 32px;
    line-height: 40px;
    color: var(--claret);
  }
  .prose :global(img) {
    width: 100%;
    height: auto;
    border-radius: var(--radius-md);
  }
  .prose :global(hr) { border: 0; border-top: 1px solid var(--tertiary); margin-block: 2em; }
  .prose :global(code) { font-size: 0.9em; }
</style>
