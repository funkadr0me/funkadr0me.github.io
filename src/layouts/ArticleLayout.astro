---
// Shared layout for a project case study or a writing piece.
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  kicker?: string;          // small line above the title, e.g. client or publication
  description?: string;
  backHref: string;
  backLabel: string;
  externalLink?: string;
  externalLabel?: string;
}

const { title, kicker, description, backHref, backLabel, externalLink, externalLabel } = Astro.props;
---

<BaseLayout title={`${title} • Purna Anantha`} description={description}>
  <article class="container article">
    <header class="article-head">
      <a class="back u-draw body-sm" href={backHref}>← {backLabel}</a>
      {kicker && <p class="body-sm muted" data-intro style="--intro-delay: 0s">{kicker}</p>}
      <h1 class="headline-lg" data-intro style="--intro-delay: 0.1s">{title}</h1>
      {description && <p class="body-lg lede" data-intro style="--intro-delay: 0.25s">{description}</p>}
      <slot name="meta" />
    </header>
    <slot name="media" />
    <div class="prose" data-intro style="--intro-delay: 0.4s">
      <slot />
    </div>
    {externalLink && (
      <p class="external">
        <a class="u-draw" href={externalLink}>{externalLabel ?? 'View the original'} ↗</a>
      </p>
    )}
  </article>
</BaseLayout>

<style>
  /* A centred reading column (680px) inside a wider band (1100px) for pictures and cards, so the
     page sits in the middle of a wide screen. Everything starts on the text column's left edge;
     the headline may run on to the band's right edge. */
  .article {
    max-width: calc(1100px + 2 * var(--space-margin));
    padding-block: var(--space-lg) var(--space-xl);
    display: grid;
    grid-template-columns: [wide-start] minmax(0, 1fr) [text-start] minmax(0, 680px) [text-end] minmax(0, 1fr) [wide-end];
    row-gap: var(--space-md);
  }
  .article > :global(*) { grid-column: text; min-width: 0; }
  /* A list of rows (the advertising page) takes the whole band, like a wide picture. */
  .article > :global(.index) { grid-column: wide; }
  .article-head {
    grid-column: text-start / wide-end;
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }
  .back { align-self: flex-start; color: var(--text); margin-bottom: var(--space-sm); }
  .lede { max-width: 640px; }

  /* Long-form text from Markdown: each block keeps to the text column; .shots and figure.wide
     take the whole band, centred on the page. */
  .article > .prose {
    grid-column: wide;
    font-size: 18px;
    line-height: 30px;
  }
  /* Every block starts on the text column's left edge, so a narrow one (a phone screen at 320px)
     lines up with the text instead of floating in the middle of the band. */
  .prose > :global(*) {
    margin-block: 0;
    max-width: 680px;
    margin-left: max(0px, calc((100% - 680px) / 2));
    margin-right: auto;
  }
  .prose > :global(* + *) { margin-top: 1.1em; }
  .prose > :global(h2) {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 45px;
    line-height: 54px;
    letter-spacing: -0.36px;
    margin-top: 1.6em;
  }
  .prose > :global(h3) {
    font-weight: 400;
    font-size: 27px;
    line-height: 32px;
    margin-top: 1.4em;
  }
  .prose > :global(:first-child) { margin-top: 0; }
  .prose :global(ul), .prose :global(ol) { padding-left: 1.2em; }
  .prose :global(li + li) { margin-top: 0.4em; }
  .prose :global(blockquote) {
    margin: 1.6em 0;
    padding: 0;
    font-family: var(--font-display);
    font-size: 32px;
    line-height: 40px;
    color: var(--claret);
  }
  .prose :global(img) {
    width: 100%;
    height: auto;
    border-radius: var(--radius-md);
  }
  .prose :global(figure) { margin-block: 2em; display: flex; flex-direction: column; gap: var(--space-xs); }
  .prose :global(figcaption) { font-size: 14px; line-height: 20px; color: var(--secondary); }
  /* A row of screens or photos, wider than the text column so phone screens stay readable. */
  .prose > :global(.shots) {
    max-width: none;
    margin-inline: 0;
    margin-block: 2em;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr));
    gap: var(--space-gutter);
    align-items: start;
  }
  /* A row kept to the text column (two phone screens side by side). */
  .prose > :global(.shots.in-column) { max-width: 680px; margin-left: max(0px, calc((100% - 680px) / 2)); }
  .prose > :global(.shots figure) { margin: 0; }
  .prose :global(.shots img) { border: 1px solid var(--tertiary); }
  /* An even row: pictures of different shapes at one height. Each figure carries its picture's
     width / height as --ratio (style="--ratio: 0.75" for 3:4), and takes that share of the row. */
  .prose > :global(.shots.even) { display: flex; }
  .prose :global(.shots.even figure) { flex: var(--ratio, 1) 1 0; min-width: 0; }
  @media (max-width: 40rem) {
    .prose > :global(.shots.even) { flex-direction: column; }
    .prose :global(.shots.even figure) { flex: none; }
  }
  /* A figure wider than the text column (the same width as .shots). */
  .prose > :global(figure.wide) { max-width: none; margin-inline: 0; }

  /* Cards of set type, for frameworks shown in a case study (principles, tones). Flat: a hairline
     border, no fill, no shadow. The names are in the display face, the rest in the body face. */
  .prose :global(.card) {
    margin: 0;
    padding: var(--space-margin);
    list-style: none;
    border: 1px solid var(--tertiary);
    border-radius: var(--radius-md);
  }
  .prose :global(.card li) { margin: 0; }
  .prose :global(.card-name) {
    font-family: var(--font-display);
    font-size: 26px;
    line-height: 32px;
    letter-spacing: -0.2px;
  }
  /* Principles: name beside its line, a hairline between rows. */
  .prose :global(.principles li) {
    display: grid;
    grid-template-columns: 14rem minmax(0, 1fr);
    column-gap: var(--space-gutter);
    align-items: baseline;
    padding-block: var(--space-sm);
    border-top: 1px solid var(--tertiary);
    font-size: 16px;
    line-height: 24px;
  }
  .prose :global(.principles li:first-child) { padding-top: 0; border-top: 0; }
  .prose :global(.principles li:last-child) { padding-bottom: 0; }
  /* Tones: three columns, a hairline between them. */
  .prose :global(.tones) { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .prose :global(.tones li) {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    padding-inline: var(--space-gutter);
    border-left: 1px solid var(--tertiary);
  }
  .prose :global(.tones li:first-child) { padding-left: 0; border-left: 0; }
  .prose :global(.tones li:last-child) { padding-right: 0; }
  .prose :global(.tone-when) { font-size: 14px; line-height: 20px; color: var(--secondary); }
  .prose :global(.tone-line) {
    margin-top: var(--space-xs);
    font-family: var(--font-display);
    font-size: 22px;
    line-height: 30px;
    color: var(--claret);
  }
  .prose :global(.tone-gloss) { font-size: 16px; line-height: 24px; }
  @media (max-width: 40rem) {
    .prose :global(.card) { padding: var(--space-gutter); }
    .prose :global(.principles li) { grid-template-columns: minmax(0, 1fr); row-gap: 4px; }
    .prose :global(.tones) { grid-template-columns: minmax(0, 1fr); }
    .prose :global(.tones li) { padding: var(--space-sm) 0; border-left: 0; border-top: 1px solid var(--tertiary); }
    .prose :global(.tones li:first-child) { padding-top: 0; border-top: 0; }
    .prose :global(.tones li:last-child) { padding-bottom: 0; }
  }
  .prose :global(hr) { border: 0; border-top: 1px solid var(--tertiary); margin-block: 2em; }
  .prose :global(code) { font-size: 0.9em; }
</style>
