---
import { settings } from '../data/site';

// The email address, kept out of the page's HTML so address-harvesting bots don't pick it up.
// The HTML holds the two halves and reads "name [at] domain"; the script below joins them into a
// real mailto link. Without JavaScript the plain "[at]" text stays, so the address is still there to copy.
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
const { emailUser: user, emailDomain: domain } = settings;
---

<a class:list={[className]} data-email-user={user} data-email-domain={domain}>{user} [at] {domain}</a>

<script>
  for (const link of document.querySelectorAll<HTMLAnchorElement>('[data-email-user]')) {
    const address = `${link.dataset.emailUser}@${link.dataset.emailDomain}`;
    link.href = `mailto:${address}`;
    link.textContent = address;
  }
</script>
