---
interface Props {
  href: string;
  variant?: 'primary' | 'secondary';
  download?: boolean;       // the link downloads a file (a PDF) instead of opening a page
}

const { href, variant = 'primary', download } = Astro.props;
---

<a class:list={['btn', variant]} href={href} download={download}><slot /></a>

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 120px;
    min-height: 52px;
    padding: var(--space-xs) var(--space-margin);
    font-family: var(--font-sans);
    font-size: 16px;
    line-height: 24px;
    text-decoration: none;
    white-space: nowrap;
    border: 1px solid transparent;
    transition: background-color var(--dur-short) var(--ease-out), color var(--dur-short) var(--ease-out), transform var(--dur-micro) var(--ease-out);
  }
  .btn:active { transform: translateY(1px); }
  .btn:focus-visible { outline: 2px solid var(--color-focus); outline-offset: 2px; }
  .btn[aria-disabled='true'] { opacity: 0.55; cursor: not-allowed; transform: none; }
  .primary {
    background: var(--primary);
    color: var(--neutral);
    border-radius: var(--radius-sm);
  }
  .primary:hover { background: var(--secondary); color: var(--neutral); }
  .secondary {
    background: var(--surface);
    color: var(--secondary);
    border-color: var(--primary);
    border-radius: var(--radius-none);
  }
  .secondary:hover { background: var(--primary); color: var(--neutral); }
</style>
