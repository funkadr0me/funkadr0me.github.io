---
import Tag from './Tag.astro';
import type { Project } from '../data/site';

// One row of the work index: who it was for, what it was, how it is filed, where to read it.
interface Props {
  project: Project;
  index?: number;
  lead?: boolean;
  compact?: boolean;   // the quieter rows of earlier work
  level?: 2 | 3;       // heading level of the title: 3 under a section head, 2 straight under a page title
}

const { project, index = 0, lead = false, compact = false, level = 3 } = Astro.props;
const titleClass = ['title', lead ? 'headline-lg' : 'headline-md'];
const linkLabel = project.linkLabel ?? 'View project';
// A bracketed summary is the CMS's "still to fill in" marker; it stays in the CMS but is not shown.
const summary = /^\[.*\]$/.test(project.summary.trim()) ? '' : project.summary;
---

<article class:list={['row', 'grid-12', { lead, compact }]} data-reveal style={`--d: ${index * 0.08}s`}>
  <div class="who">
    <p class="client body-sm muted">{project.client}</p>
    {project.blockText && <p class="figure">{project.blockText}</p>}
  </div>
  <div class="what">
    {project.thumb && <img class="media" src={project.thumb} alt={project.thumbAlt ?? ''} loading={lead ? 'eager' : 'lazy'} fetchpriority={lead ? 'high' : undefined} />}
    {level === 2 ? <h2 class:list={titleClass}>{project.title}</h2> : <h3 class:list={titleClass}>{project.title}</h3>}
    {summary && <p class="summary">{summary}</p>}
  </div>
  <div class="meta">
    <div class="tags">
      {project.tags.map((tag) => <Tag tone={tag.tone}>{tag.label}</Tag>)}
    </div>
    <a class="go u-draw" href={project.href} aria-label={`${linkLabel}: ${project.title}`}>{linkLabel}</a>
  </div>
</article>

<style>
  .row {
    position: relative;
    align-items: start;
    row-gap: var(--space-sm);
    padding-block: var(--space-2xl);
    border-bottom: 1px solid var(--color-rule);
  }
  .row.lead { padding-top: var(--space-3xl); }
  .row.compact { padding-block: var(--space-md); }
  /* Stills from the archive come in many shapes: the same 4:3 crop and a hairline make them one set. */
  .row.compact .media { max-width: 360px; outline: 1px solid var(--color-rule); outline-offset: -1px; }
  .who { grid-column: 1 / span 3; display: flex; flex-direction: column; gap: var(--space-xs); }
  .what { grid-column: 4 / span 6; display: flex; flex-direction: column; gap: var(--space-sm); }
  .meta { grid-column: 10 / -1; display: flex; flex-direction: column; align-items: flex-start; gap: var(--space-sm); }

  .figure { font-family: var(--font-display); font-size: var(--text-title); line-height: 1.1; font-variant-numeric: tabular-nums; }
  .title { color: var(--color-ink); transition: color var(--dur-short) var(--ease-out); }
  .summary { max-width: 46ch; }
  .media { width: 100%; max-width: 640px; aspect-ratio: 4 / 3; object-fit: cover; object-position: 50% 0%; border-radius: var(--radius-sm); }
  .tags { display: flex; flex-wrap: wrap; gap: var(--space-xs); }

  /* The whole row is the link; the hover signal is the title's colour. */
  .go::after { content: ""; position: absolute; inset: 0; }
  .row:hover .title { color: var(--color-accent); }
  .go:focus-visible { outline: none; }
  .row:has(.go:focus-visible) { outline: 2px solid var(--color-focus); outline-offset: -2px; }

  @media (max-width: 60rem) {
    .row { padding-block: var(--space-lg); }
    .who, .what, .meta { grid-column: 1 / -1; }
  }
</style>
