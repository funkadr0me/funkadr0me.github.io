---
import Tag from './Tag.astro';
import type { Project } from '../data/site';
import { CARD_WIDTHS, pictureSize, responsive } from '../data/pictures';

// One piece of work. On the home page it is a card in the work grid: picture, who it was for,
// what it was, where to read it; its tags are left to the case study, to keep the grid light.
// `strip` lays the archive out as one slim line under the case cards (the home page decides when).
// `compact` makes it a quieter row instead, tags included, for the earlier work on the advertising page.
interface Props {
  project: Project;
  index?: number;
  lead?: boolean;      // the first card or row: its picture loads first
  compact?: boolean;   // a row of earlier work instead of a card
  level?: 2 | 3;       // heading level of the title: 3 under a section head, 2 straight under a page title
  strip?: boolean;     // a strip across the grid instead of a card
}

const { project, index = 0, lead = false, compact = false, level = 3, strip = false } = Astro.props;
const linkLabel = project.linkLabel ?? 'View project';
// A bracketed summary is the CMS's "still to fill in" marker; it stays in the CMS but is not shown.
const summary = /^\[.*\]$/.test(project.summary.trim()) ? '' : project.summary;
const Title = level === 2 ? 'h2' : 'h3';
// A card's picture comes in smaller copies; a row's still is small already and only needs its size stated.
const picture = project.thumb && !compact ? await responsive(project.thumb, CARD_WIDTHS) : undefined;
const still = project.thumb && compact ? await pictureSize(project.thumb) : undefined;
// How wide a card is drawn (home.css, the work grid): one, two, three, then five across.
const cardSizes = '(max-width: 40rem) calc(100vw - 32px), (max-width: 72rem) 50vw, (max-width: 80rem) 31vw, 237px';
---

{compact ? (
  <article class="item row grid-12" data-reveal style={`--d: ${index * 0.08}s`}>
    <div class="who">
      <p class="client body-sm muted">{project.client}</p>
      {project.blockText && <p class="figure">{project.blockText}</p>}
    </div>
    <div class="what">
      {project.thumb && <img class="media" {...still} src={project.thumb} alt={project.thumbAlt ?? ''} loading={lead ? 'eager' : 'lazy'} fetchpriority={lead ? 'high' : undefined} />}
      <Title class="title headline-md">{project.title}</Title>
      {summary && <p class="summary">{summary}</p>}
    </div>
    <div class="meta">
      <div class="tags">
        {project.tags.map((tag) => <Tag tone={tag.tone}>{tag.label}</Tag>)}
      </div>
      <div class="links">
        <a class="go u-draw" href={project.href} aria-label={`${linkLabel}: ${project.title}`}>{linkLabel}</a>
        {project.secondLink && (
          <a class="go-second u-draw" href={project.secondLink} aria-label={`${project.secondLinkLabel ?? 'Read more'}: ${project.title}`}>{project.secondLinkLabel ?? 'Read more'}</a>
        )}
      </div>
    </div>
  </article>
) : (
  <article class:list={['item card', { strip }]} data-reveal style={`--d: ${index * 0.08}s`}>
    {picture && <img class="media" {...picture} sizes={picture.srcset && cardSizes} alt={project.thumbAlt ?? ''} loading={lead ? 'eager' : 'lazy'} fetchpriority={lead ? 'high' : undefined} />}
    <p class="client body-sm muted">{project.client}{(project.cardRole || project.blockText) && <span> · {project.cardRole || project.blockText}</span>}</p>
    <Title class="title card-title">{project.title}</Title>
    {summary && <p class="summary body-sm">{summary}</p>}
    <div class="links">
      <a class="go u-draw" href={project.href} aria-label={`${linkLabel}: ${project.title}`}>{linkLabel}</a>
      {project.secondLink && (
        <a class="go-second u-draw" href={project.secondLink} aria-label={`${project.secondLinkLabel ?? 'Read more'}: ${project.title}`}>{project.secondLinkLabel ?? 'Read more'}</a>
      )}
    </div>
  </article>
)}

<style>
  .item { position: relative; }
  .title { color: var(--color-ink); transition: color var(--dur-short) var(--ease-out); }
  .tags { display: flex; flex-wrap: wrap; gap: var(--space-xs); }
  .links { display: flex; flex-wrap: wrap; column-gap: var(--space-gutter); row-gap: var(--space-xs); }
  .media { display: block; width: 100%; border-radius: var(--radius-sm); }

  /* Card: a hairline above, no box. Cards in a row share a height, so the links line up at the bottom. */
  .card {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    padding-top: var(--space-sm);
    border-top: 1px solid var(--color-rule);
  }
  .card .media { height: auto; aspect-ratio: 4 / 3; object-fit: cover; object-position: 50% 0%; margin-bottom: var(--space-xs); }
  .card .client { margin-bottom: calc(-1 * var(--space-xs)); }
  .card-title {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: var(--text-title);
    line-height: 1.15;
    letter-spacing: -0.36px;
    overflow-wrap: break-word;
    min-width: 0;
    text-wrap: balance;
  }
  .card .links { margin-top: auto; padding-top: var(--space-xs); }

  /* Strip: the archive under a full row of case cards. It stands for a whole page of work, so it takes
     another shape: words only (name, summary and link in one line across the grid). Its picture
     would have to be thumbnail-small to keep Work within one 1440 x 900 screen, so it is left out
     here; on a phone the archive is a card like the rest, picture and all. */
  @media (min-width: 40rem) {
    .card.strip {
      grid-column: 1 / -1;
      display: grid;
      grid-template-columns: minmax(0, 18rem) minmax(0, 1fr) auto;
      column-gap: var(--gap-columns);
      row-gap: 4px;
      align-items: center;
    }
    .strip .media { display: none; }
    .strip .client { grid-column: 1; margin: 0; }
    .strip .title { grid-column: 1; font-size: var(--text-role-s); }
    .strip .summary { grid-column: 2; grid-row: 1 / 3; max-width: 52ch; }
    .strip .links { grid-column: 3; grid-row: 1 / 3; margin: 0; padding: 0; }
  }
  /* Too narrow for one line: the words stack. */
  @media (min-width: 40rem) and (max-width: 60rem) {
    .card.strip { grid-template-columns: minmax(0, 1fr); align-items: start; }
    .strip .summary, .strip .links { grid-column: 1; grid-row: auto; }
  }

  /* Row: the earlier work on the advertising page. */
  .row {
    align-items: start;
    row-gap: var(--space-sm);
    padding-block: var(--space-md);
    border-bottom: 1px solid var(--color-rule);
  }
  .who { grid-column: 1 / span 3; display: flex; flex-direction: column; gap: var(--space-xs); }
  .what { grid-column: 4 / span 6; display: flex; flex-direction: column; gap: var(--space-sm); }
  .meta { grid-column: 10 / -1; display: flex; flex-direction: column; align-items: flex-start; gap: var(--space-sm); }
  .figure { font-family: var(--font-display); font-size: var(--text-title); line-height: 1.1; font-variant-numeric: tabular-nums; }
  .summary { max-width: 46ch; }
  /* Stills from the archive come in many shapes: each is shown whole, and a hairline makes them one set. */
  .row .media { max-width: 360px; height: auto; object-fit: contain; outline: 1px solid var(--color-rule); outline-offset: -1px; }

  /* The whole card or row is the link; the hover signal is the title's colour. */
  .row .links a { white-space: nowrap; } /* a link label stays on one line in the narrow meta column */
  .go::after { content: ""; position: absolute; inset: 0; }
  .item:hover .title { color: var(--color-accent); }
  /* The second link sits above the card-wide link so it stays clickable on its own. */
  .go-second { position: relative; z-index: 1; }
  .go:focus-visible { outline: none; }
  .item:has(.go:focus-visible) { outline: 2px solid var(--color-focus); outline-offset: var(--space-xs); }
  .row:has(.go:focus-visible) { outline-offset: -2px; }

  @media (max-width: 60rem) {
    .row { padding-block: var(--space-md); }
    .who, .what, .meta { grid-column: 1 / -1; }
  }
</style>
