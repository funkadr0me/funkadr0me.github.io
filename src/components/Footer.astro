---
---

<footer>
  <div class="container colophon">
    <p class="mark headline-md">Purna Anantha</p>
    <p class="where body-sm muted">Jakarta, Indonesia &amp; beyond<br />Bahasa Indonesia and English</p>
  </div>
</footer>

<script>
  // The footer's real height as --footer-h: on the home page the contact section fills the screen above it,
  // so the last screen is the contact statement with the footer under it.
  const footer = document.querySelector<HTMLElement>('footer');
  if (footer) {
    const setFooterHeight = () => document.documentElement.style.setProperty('--footer-h', `${footer.offsetHeight}px`);
    setFooterHeight();
    if ('ResizeObserver' in window) new ResizeObserver(setFooterHeight).observe(footer);
  }
</script>

<style>
  footer { border-top: 1px solid var(--tertiary); }
  .colophon {
    padding-block: var(--space-lg) var(--space-md);
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: var(--space-sm) var(--space-md);
  }
  .where { text-align: right; }
  @media (max-width: 640px) {
    .colophon { padding-block: var(--space-md); }
    .where { text-align: left; }
  }
</style>
