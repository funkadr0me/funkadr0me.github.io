---
// `toTop`: the "Back to the top" line. The home page turns it off: its contact band ends in the same line as a scroll cue.
const { toTop = true } = Astro.props;
---

<footer>
  <div class="container colophon">
    <p class="mark headline-md">Purna Anantha</p>
    <div class="end">
      {toTop && <p class="bottom body-sm">That’s me, top to bottom. <a class="to-top" href="#top">Back to the top<span aria-hidden="true">&nbsp;↑</span></a></p>}
      <p class="where body-sm muted">Jakarta, Indonesia &amp; beyond<br />Bahasa Indonesia and English</p>
    </div>
  </div>
</footer>

<script>
  // The footer's real height as --footer-h: on the home page the contact section fills the screen above it,
  // so the last screen is the contact statement with the footer under it.
  const footer = document.querySelector<HTMLElement>('footer');
  if (footer) {
    const setFooterHeight = () => document.documentElement.style.setProperty('--footer-h', `${footer.offsetHeight}px`);
    setFooterHeight();
    if ('ResizeObserver' in window) new ResizeObserver(setFooterHeight).observe(footer);
  }
</script>

<style>
  footer { border-top: 1px solid var(--tertiary); }
  .colophon {
    padding-block: var(--space-md); /* the same air above and below the name */
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: var(--space-sm) var(--space-md);
  }
  .end { display: flex; flex-direction: column; gap: var(--space-xs); text-align: right; }
  .bottom { margin: 0; }
  /* A 14px link with a 44px target: the padding widens the hit area without moving the line. */
  .to-top { display: inline-block; padding-block: 12px; margin-block: -12px; white-space: nowrap; }
  .where { margin: 0; }
  @media (max-width: 640px) {
    .end { text-align: left; }
  }
</style>
