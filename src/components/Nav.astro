---
import { settings, getWriting, WRITING_SECTION_MIN } from '../data/site';

interface Props {
  current?: string;
}

// On the home page the underline follows the section in view (script below), so nothing is marked
// at first. Elsewhere it marks the part of the site you are in: Writing on /writing/..., Work otherwise.
const path = Astro.url.pathname;
const isHome = path === '/';
const { current = isHome ? undefined : path.startsWith('/resume') ? '/resume/' : path.startsWith('/writing') ? '/#writing' : '/#work' } = Astro.props;

// Writing has a home page section, and so a nav link, only once there are enough pieces.
const hasWritingSection = (await getWriting()).length >= WRITING_SECTION_MIN;

const links = [
  { href: '/#work', label: 'Work' },
  ...(hasWritingSection ? [{ href: '/#writing', label: 'Writing' }] : []),
  { href: '/#experience', label: 'Experience' },
  { href: '/resume/', label: 'Resume' },
  { href: '/#contact', label: 'Contact', action: true },
];
---

<header class="site-header">
  <nav aria-label="Main" class="container">
    <div class="id">
      <a class="name" href="/">Purna Anantha</a>
      <span class="sep muted" aria-hidden="true">•</span>
      <span class="role body-sm muted">{settings.label}</span>
    </div>
    <div class="links">
      {links.map((link) => (
        <a
          class:list={['item', { action: link.action }]}
          href={link.href}
          aria-current={link.href === current ? 'page' : undefined}
          data-section={link.href.split('#')[1]}
        >
          {link.label}
        </a>
      ))}
    </div>
  </nav>
</header>

<script>
  // The header's real height (it grows to two or three rows on a phone) as --header-h: the home page's hero is one
  // screen under it, and nav jumps land below it.
  const siteHeader = document.querySelector<HTMLElement>('.site-header');
  if (siteHeader) {
    const setHeaderHeight = () => document.documentElement.style.setProperty('--header-h', `${siteHeader.offsetHeight}px`);
    setHeaderHeight(); // at once, then whenever the header's size changes (a font loading, a turned phone)
    if ('ResizeObserver' in window) new ResizeObserver(setHeaderHeight).observe(siteHeader);
  }

  // Home page: underline the nav link of the section in view. A section counts while any of it is in the band
  // between the header and 40% of the screen; one that only touches the header's edge (the section above, once the
  // next is snapped under the header) does not. The hero and the About band have no link, so they leave all plain.
  if (location.pathname === '/' && siteHeader) {
    const links = [...document.querySelectorAll<HTMLAnchorElement>('.site-header [data-section]')];
    const sections = links
      .map((link) => document.getElementById(link.dataset.section ?? ''))
      .filter((section): section is HTMLElement => section !== null);
    const mark = (id?: string) =>
      links.forEach((link) => {
        if (link.dataset.section === id) link.setAttribute('aria-current', 'location');
        else link.removeAttribute('aria-current');
      });
    const update = () => {
      const top = siteHeader.offsetHeight + 1;
      const bottom = innerHeight * 0.4;
      let current: string | undefined;
      for (const section of sections) {
        const box = section.getBoundingClientRect();
        if (box.bottom > top && box.top < bottom) current = section.id;
      }
      mark(current);
    };
    let queued = false;
    addEventListener('scroll', () => {
      if (queued) return;
      queued = true;
      requestAnimationFrame(() => { queued = false; update(); });
    }, { passive: true });
    addEventListener('resize', update);
    update();
  }
</script>

<style>
  .site-header { border-bottom: 1px solid var(--tertiary); }
  nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    column-gap: var(--space-xs);
    /* The padding keeps the header's line clear of the Contact button when the bar wraps to two rows (a phone,
       a tablet); on one row it sits inside the 72px, so nothing moves. No row gap: the name and the links
       already pad each other apart. */
    padding-block: var(--space-xs);
    min-height: var(--nav-h, 72px);
  }
  a { color: var(--text); text-decoration: none; white-space: nowrap; }
  .id { display: flex; flex-wrap: wrap; align-items: baseline; column-gap: var(--space-sm); }
  /* The dot sits between the name and the label while they share a line. Below about 460px the label
     drops under the name (with today's label), so the dot goes rather than start a line on its own. */
  /* Same type as the label beside it (which takes the global `.role` style from home.css). */
  .sep { font-family: var(--font-display); font-size: var(--text-role-s); line-height: 1.2; }
  @media (max-width: 30rem) { .sep { display: none; } }
  .name { padding: 12px 0; font-family: var(--font-display); font-size: 28px; line-height: 32px; letter-spacing: -0.36px; }
  .links { display: flex; flex-wrap: wrap; align-items: center; gap: 4px; }
  .item {
    padding: 12px var(--space-sm);
    border-bottom: 2px solid transparent;
    transition: border-color var(--dur-short) var(--ease-out), background-color var(--dur-short) var(--ease-out), color var(--dur-short) var(--ease-out);
  }
  .item:hover { border-bottom-color: var(--tertiary); color: var(--text); }
  .item:not(.action)[aria-current] { color: var(--text); border-bottom-color: var(--claret); }
  /* The hire action: outlined, quieter than the hero's filled button. */
  .item.action {
    margin-left: var(--space-xs);
    display: inline-flex;
    align-items: center;
    min-height: 48px; /* as tall as the page's buttons */
    padding: 0 var(--space-gutter);
    border: 1px solid var(--primary);
    border-radius: var(--radius-sm);
  }
  .item.action:hover { background: var(--primary); color: var(--neutral); border-color: var(--primary); }
  @media (max-width: 640px) {
    .id .role, .id .sep { display: none; } /* the name and the links are enough of a bar on a phone */
    .links { margin-inline: calc(-1 * var(--space-xs)); gap: 0; }
    .item { padding-inline: var(--space-xs); }
    .item.action { margin-left: var(--space-2xs, 4px); padding-inline: var(--space-sm); }
  }
</style>
