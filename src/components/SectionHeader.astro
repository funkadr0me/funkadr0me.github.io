---
interface Props {
  title: string;
  id?: string;
}

const { title, id } = Astro.props;
---

<div class="head" data-reveal>
  <h2 class="headline-lg" id={id}>{title}</h2>
  <div class="aside body-sm muted"><slot /></div>
</div>

<style>
  .head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-sm);
    border-top: 1px solid var(--tertiary);
    padding-top: var(--space-md);
  }
</style>
