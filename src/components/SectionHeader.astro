---
interface Props {
  title: string;
  id?: string;
}

const { title, id } = Astro.props;
---

<div class="head" data-reveal>
  <h2 class="headline-lg" id={id}>{title}</h2>
  <div class="aside body-sm muted"><slot /></div>
</div>

<style>
  .head {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gap-columns);
    row-gap: var(--space-sm);
    align-items: baseline;
    border-top: 1px solid var(--color-rule);
    padding-top: var(--space-md);
  }
  h2 { grid-column: 1 / span 8; text-wrap: balance; }
  .aside { grid-column: 9 / -1; justify-self: end; text-align: right; }

  @media (max-width: 60rem) {
    h2, .aside { grid-column: 1 / -1; justify-self: start; text-align: left; }
  }
</style>
