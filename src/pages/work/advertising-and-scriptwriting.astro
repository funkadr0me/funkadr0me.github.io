---
// The agency and scriptwriting years on one page: every project marked `era: earlier`, in order.
// The home page links here from its "Advertising & scriptwriting" row.
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getProjects } from '../../data/site';
import { ids } from '../../data/schema';

const projects = await getProjects();
const pieces = projects.filter((project) => project.era === 'earlier');
// A shared link shows the picture of this page's own card on the home page.
const card = projects.find((project) => project.href === '/work/advertising-and-scriptwriting/');
// Structured data lists the six pieces as works Purna contributed to (data/schema.ts).
const personId = ids(Astro.site!).person;
---

<ArticleLayout
  title="Advertising & scriptwriting"
  kicker="2008 to 2018"
  description="Before UX writing, I spent ten years making people stop and look, in thirty seconds or a single page. Here are six of my favorites, from a selfie phone to a Muppet orangutan."
  backHref="/#work"
  backLabel="All work"
  externalLink="https://theworkssofar.tumblr.com/"
  externalLabel="More in the full archive"
  image={card?.thumb}
  imageAlt={card?.thumbAlt}
  schema={{
    type: 'CollectionPage',
    extra: { hasPart: pieces.map((piece) => ({ '@type': 'CreativeWork', name: piece.title, ...(piece.summary && { description: piece.summary }), contributor: { '@id': personId } })) },
  }}
>
  <div slot="media" class="index">
    {pieces.map((project, i) => <ProjectCard project={project} index={i} lead={i === 0} compact level={2} />)}
  </div>
</ArticleLayout>
