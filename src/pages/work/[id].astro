---
// One page per project that has a write-up (text below its frontmatter) → /work/<file-name>/
import { render } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import Tag from '../../components/Tag.astro';
import { getProjectEntries, hasWriteUp } from '../../data/site';
import { pictureSize } from '../../data/pictures';

export async function getStaticPaths() {
  const entries = await getProjectEntries();
  return entries.filter(hasWriteUp).map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { data } = entry;
const { Content } = await render(entry);
const coverSize = data.image ? await pictureSize(data.image) : undefined;
// The facts under the title: role first, then when, with whom and what came of it. Blank ones are left out.
const facts = [
  ['Role', data.role],
  ['Timeline', data.timeline],
  ['Team', data.team],
  ['Outcome', data.outcome],
].filter((fact): fact is [string, string] => Boolean(fact[1]));
---

<ArticleLayout
  title={data.title}
  kicker={data.client}
  description={data.summary}
  backHref="/#work"
  backLabel="All work"
  externalLink={data.link}
  externalLabel={data.linkLabel ?? 'See it live'}
  image={data.thumb ?? data.image}
  imageAlt={data.thumb ? data.thumbAlt : data.imageAlt}
>
  <div slot="meta" class="meta" data-intro style="--intro-delay: 0.3s">
    {facts.length > 0 && (
      <dl class="facts">
        {facts.map(([label, value]) => (
          <div class="fact">
            <dt class="body-sm muted">{label}</dt>
            <dd class={label === 'Role' ? 'body-lg' : 'body-md'}>{value}</dd>
          </div>
        ))}
      </dl>
    )}
    <div class="tags">
      {data.tags.map((tag) => <Tag tone={tag.tone}>{tag.label}</Tag>)}
    </div>
  </div>
  {data.image && (
    <img slot="media" class="cover" {...coverSize} src={data.image} alt={data.imageAlt ?? ''} fetchpriority="high" />
  )}
  <Content />
</ArticleLayout>

<style>
  .meta { display: flex; flex-direction: column; gap: var(--space-sm); }
  /* Role, timeline, team and outcome: label beside its value, one hairline above the group. */
  .facts {
    margin: 0;
    display: grid;
    gap: var(--space-xs);
    padding-top: var(--space-sm);
    border-top: 1px solid var(--tertiary);
  }
  .fact {
    display: grid;
    grid-template-columns: 5.5rem minmax(0, 1fr);
    column-gap: var(--space-sm);
    align-items: baseline;
  }
  .fact dd { margin: 0; }
  @media (max-width: 24rem) {
    .fact { grid-template-columns: minmax(0, 1fr); }
  }
  .tags { display: flex; flex-wrap: wrap; gap: var(--space-xs); }
  /* Shown whole, on the headline's left edge: covers range from wide screens to tall phone screens. */
  .cover {
    grid-column: text-start / wide-end;
    justify-self: start;
    width: auto;
    height: auto;
    max-width: 100%;
    max-height: 640px;
    object-fit: contain;
    border-radius: var(--radius-md);
  }
</style>
