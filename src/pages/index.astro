---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import ProjectCard from '../components/ProjectCard.astro';
import SectionHeader from '../components/SectionHeader.astro';
import { settings, getProjects, getWriting, experience, awards, links } from '../data/site';

const projects = await getProjects();
const writing = await getWriting();

// Verb/noun pairs flip in the headline (src/scripts/flip-headline.ts); the static page shows the first.
const pairs = settings.pairs;
const first = pairs[0];
const headline = `${first.verb} ${first.noun} ${settings.headlineTail}`;
const roles = settings.roles.length ? settings.roles : [settings.label];
const rolesSentence = roles.length > 1 ? `${roles.slice(0, -1).join(', ')} and ${roles.at(-1)}` : roles[0];

// A value like "Medium · Bukalapak Product Design" is shown one part to a line.
const parts = (value: string) => value.split(' · ');
---

<BaseLayout>
  <!-- Hero -->
  <section class="container hero">
    <h1 class="headline-display" aria-label={headline} data-flip={JSON.stringify(pairs)}>
      <span class="flip-line" aria-hidden="true" style="--i: 0">
        <span class="flip-slot" data-flip-verb><span class="flip-word"><span class="flip-txt">{first.verb}</span><span class="flip-caret"></span></span></span>
        <span class="flip-slot" data-flip-noun><span class="flip-word">{first.noun}</span></span>
      </span>
      <span class="flip-rest" aria-hidden="true" style="--i: 1">{settings.headlineTail}</span>
    </h1>
    <div class="hero-foot grid-12">
      <p class="intro" data-intro style="--intro-delay: 0.75s">
        {settings.intro}
      </p>
      <div class="actions" data-intro style="--intro-delay: 0.9s">
        <Button href="#work">See the work</Button>
        <Button href="#contact" variant="secondary">Give me a shout</Button>
      </div>
    </div>
  </section>

  <!-- Work -->
  <section class="container section" id="work">
    <SectionHeader title="Carefully curated">Selected work, 2008 to present</SectionHeader>
    <div class="index">
      {projects.map((project, i) => <ProjectCard project={project} index={i} lead={i === 0} />)}
    </div>
  </section>

  <!-- About band -->
  <section class="about" data-wipe>
    <div class="container about-inner grid-12">
      <h2 class="headline-lg about-head">{settings.aboutLabel}</h2>
      <div class="about-body">
        <p class="about-text">{settings.about}</p>
        <p class="roles">
          <span class="sr-only">{settings.label}: {rolesSentence}, based in {settings.location}</span>
          <span aria-hidden="true">{settings.label} in {settings.location}: <span class="typing" data-typing={JSON.stringify(roles)}><span class="typing-text">{roles[0]}</span><span class="typing-caret"></span></span></span>
        </p>
      </div>
    </div>
  </section>

  <!-- Writing -->
  <section class="container section top" id="writing">
    <SectionHeader title="I think, therefore I write">Writings &amp; other documented blabbers</SectionHeader>
    <div class="writing-rows">
      {writing.map((post, i) => (
        <a class="post grid-12" href={post.href} data-reveal style={`--d: ${i * 0.05}s`}>
          <span class="post-title">{post.title}</span>
          <span class="post-source body-sm muted">{parts(post.source).map((part) => <span>{part}</span>)}</span>
        </a>
      ))}
    </div>
  </section>

  <!-- Experience -->
  <section class="container section top" id="experience">
    <SectionHeader title="The road so far"><a class="u-draw" href={links.resume}>Full resume</a></SectionHeader>
    <div class="jobs">
      {experience.map((job, i) => (
        <div class="job grid-12" data-reveal style={`--d: ${i * 0.05}s`}>
          <span class="years body-sm muted">{job.years}</span>
          <span class="role">{job.role}</span>
          <span class="org muted">{parts(job.org).map((part) => <span>{part}</span>)}</span>
        </div>
      ))}
    </div>
  </section>

  <!-- Awards -->
  <section class="container section top">
    <div class="awards-block">
      <h3 class="awards-label body-sm muted">Awards</h3>
      <div class="awards">
        {awards.map((award, i) => (
          <div class="award" data-reveal style={`--d: ${i * 0.08}s`}>
            <span class="award-name">{award.name}</span>
            <span class="body-sm muted">{award.detail}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Contact -->
  <section class="container section top contact" id="contact">
    <h2 class="headline-display" data-reveal>{settings.contactHeadline}</h2>
    <div class="contact-body grid-12">
      <p class="contact-text" data-reveal style="--d: 0.1s">
        {settings.contactText}
      </p>
      <div class="contact-links" data-reveal style="--d: 0.2s">
        <a class="contact-mail u-draw" href={`mailto:${links.email}`}>{links.email}</a>
        <p class="contact-more">
          <a class="u-draw" href={links.linkedin}>LinkedIn</a>
          <a class="u-draw" href={links.twitter}>Twitter</a>
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
