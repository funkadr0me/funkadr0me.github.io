---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import Email from '../components/Email.astro';
import ScrollCue from '../components/ScrollCue.astro';
import ProjectCard from '../components/ProjectCard.astro';
import SectionHeader from '../components/SectionHeader.astro';
import { settings, getProjects, getWriting, experience, awards, companyLogos, logoSize, links, WRITING_SECTION_MIN } from '../data/site';
import { PORTRAIT_WIDTHS, responsive } from '../data/pictures';

const projects = await getProjects();
const portrait = settings.portrait ? await responsive(settings.portrait, PORTRAIT_WIDTHS) : undefined;
// Earlier work lives on its own page (/work/advertising-and-scriptwriting/), reached from the archive row.
const current = projects.filter((project) => project.era === 'now');
// The case cards share one row on a wide screen: four across, five once there are five. The archive (`strip`) is a
// card in that row while the row has room; once the cases fill it, it becomes a slim strip under them.
const cases = current.filter((project) => !project.strip);
const stripped = cases.length >= 4;
const work = [...cases, ...current.filter((project) => project.strip)];
const writing = await getWriting();
const writingSection = writing.length >= WRITING_SECTION_MIN; // otherwise the pieces get a line in the About band

// Verbs and nouns turn in the headline like a split-flap board (src/scripts/flip-headline.ts); the static page shows the first of each.
const { verbs, nouns } = settings;
const first = { verb: verbs[0], noun: nouns[0] };
const headline = `${first.verb} ${first.noun} ${settings.headlineTail}`;
const roles = settings.roles.length ? settings.roles : [settings.label];
const rolesSentence = roles.length > 1 ? `${roles.slice(0, -1).join(', ')} and ${roles.at(-1)}` : roles[0];

// A value like "Medium · Bukalapak Product Design" is shown one part to a line.
const parts = (value: string) => value.split(' · ');
---

<BaseLayout>
  <!-- Hero -->
  <section class="container hero">
    <div class="hero-title">
      <h1 class="headline-display" aria-label={headline} data-flip={JSON.stringify({ verbs, nouns })}>
        <span class="flip-line" style="--i: 0">
          <span class="flip-slot" data-flip-verb><span class="flip-word" aria-hidden="true">{first.verb}</span></span>
          <span class="flip-slot" data-flip-noun><span class="flip-word" aria-hidden="true">{first.noun}</span></span>
        </span>
        <span class="flip-rest" aria-hidden="true" style="--i: 1">{settings.headlineTail}</span>
      </h1>
      <p class="intro" data-intro style="--intro-delay: 0.75s">
        {settings.intro}
      </p>
      <!-- WCAG 2.2.2: the loops run past five seconds, so a visible pause control stays, as an icon with a text name; it sits with the headline it holds. -->
      <button class="loop-toggle" type="button" data-loop-toggle aria-label="Pause motion" title="Pause motion" hidden>
        <svg class="icon-pause" viewBox="0 0 16 16" aria-hidden="true"><rect x="3" y="2" width="3.5" height="12" /><rect x="9.5" y="2" width="3.5" height="12" /></svg>
        <svg class="icon-play" viewBox="0 0 16 16" aria-hidden="true"><path d="M4 2l10 6-10 6z" /></svg>
      </button>
    </div>
    <ScrollCue href="#work" label="Next: Work" />
  </section>

  <!-- Work -->
  <section class="container section" id="work">
    <SectionHeader title="Words at work">Product writing since 2018, ads before that</SectionHeader>
    <div class:list={['index cards', { five: stripped && cases.length >= 5 }]}>
      {work.map((project, i) => <ProjectCard project={project} index={i} lead={i === 0} strip={stripped && project.strip} />)}
    </div>
    <ScrollCue href="#about" label="Next: About" />
  </section>

  <!-- About band -->
  <section class="about" id="about" data-wipe>
    <div class="container about-inner grid-12">
      <h2 class="headline-lg about-head">{settings.aboutLabel}</h2>
      {portrait && <img class="about-portrait" {...portrait} sizes={portrait.srcset && '(max-width: 60rem) 192px, 256px'} alt={settings.portraitAlt ?? ''} loading="lazy" />}
      <div class="about-body">
        <div class="about-text">
          {settings.about.split(/\n+/).filter(Boolean).map((paragraph) => <p>{paragraph}</p>)}
        </div>
        {!writingSection && writing.length > 0 && (
          <p class="about-writing">
            I also write about the craft:{' '}
            {writing.map((post, i) => (
              <>{i > 0 && (i === writing.length - 1 ? ' and ' : ', ')}<a href={post.href}>{post.title}</a></>
            ))}.
          </p>
        )}
        <p class="roles">{rolesSentence}.</p>
      </div>
      <ScrollCue href={writingSection ? '#writing' : '#experience'} label={writingSection ? 'Next: Writing' : 'Next: Experience'} />
    </div>
  </section>

  <!-- Writing: its own section once there are enough pieces -->
  {writingSection && (
  <section class="container section top" id="writing">
    <SectionHeader title="I think, therefore I write">Writings &amp; other documented blabbers</SectionHeader>
    <div class="writing-rows">
      {writing.map((post, i) => (
        <a class="post grid-12" href={post.href} data-reveal style={`--d: ${i * 0.05}s`}>
          <span class="post-title">{post.title}</span>
          <span class="post-source body-sm muted">{parts(post.source).map((part) => <span>{part}</span>)}</span>
        </a>
      ))}
    </div>
    <ScrollCue href="#experience" label="Next: Experience" />
  </section>
  )}

  <!-- Experience and awards: one screen -->
  <section class="container section top" id="experience">
    <SectionHeader title="The road so far"><a class="u-draw" href={links.resume}>Full resume</a></SectionHeader>
    <div class="jobs">
      {experience.map((job, i) => (
        <div class="job grid-12" data-reveal style={`--d: ${i * 0.05}s`}>
          <span class="years body-sm muted">{job.years}</span>
          <span class="role">{job.role}</span>
          <span class="org muted">
            {parts(job.org).map((company) => companyLogos[company]
              ? <img class="org-logo" src={companyLogos[company]} alt={company} loading="lazy" {...logoSize(companyLogos[company], 1700, 20, 30)} />
              : <span class="org-name">{company}</span>)}
          </span>
        </div>
      ))}
    </div>
    <div class="awards-block">
      <h3 class="awards-label body-sm muted">Awards</h3>
      <div class="awards">
        {awards.map((award, i) => (
          <div class="award" data-reveal style={`--d: ${i * 0.08}s`}>
            {award.logo && <span class="award-mark"><img class="award-logo" src={award.logo} alt="" loading="lazy" {...logoSize(award.logo, 2800, 24, 36)} /></span>}
            <span class="award-name">{award.name}</span>
            <span class="body-sm muted">{award.detail.split('\n').map((line, j) => <>{j > 0 && <br />}{line}</>)}</span>
          </div>
        ))}
      </div>
    </div>
    <ScrollCue href="#contact" label="Next: Contact" />
  </section>

  <!-- Contact: the second claret band; with the footer it makes the last screen -->
  <section class="contact" id="contact" data-wipe>
    <div class="container contact-inner">
      <h2 class="headline-display">{settings.contactHeadline}</h2>
      <div class="contact-body grid-12">
        <p class="contact-text">
          {settings.contactText}
        </p>
        <div class="contact-links">
          <Email button />
          <Button href={links.linkedin} variant="secondary">LinkedIn</Button>
        </div>
      </div>
      <ScrollCue href="#top" label="That’s me, top to bottom. Back to the top" arrow="↑" />
    </div>
  </section>
</BaseLayout>
